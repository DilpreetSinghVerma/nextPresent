# ─────────────────────────────────────────────────────────────────
# NXTslide Environment Configuration
# ─────────────────────────────────────────────────────────────────

# Local Server Port (Default: 3333)
PORT=3333

# Cloud Relay Server URL (Default: https://nextpresent-relay.onrender.com)
RELAY_URL=https://nextpresent-relay.onrender.com

# ─────────────────────────────────────────────────────────────────
# Pro Lifetime Licensing Configuration ($19 one-time)
# ─────────────────────────────────────────────────────────────────

# Provider Options: 'lemonsqueezy' | 'gumroad' | 'dev'
# Leave unset to allow instant direct key activation & dev testing
LICENSE_PROVIDER=lemonsqueezy

# Lemon Squeezy Setup:
# 1. Create a product on https://www.lemonsqueezy.com/ with "Generate license keys" enabled
# 2. Paste your checkout URL below:
CHECKOUT_URL=https://yourstore.lemonsqueezy.com/buy/nxtslide-pro
LEMON_STORE_ID=your_store_id

# Gumroad Setup (Alternative):
# GUMROAD_PRODUCT_PERMALINK=nxtslide-pro
# CHECKOUT_URL=https://gumroad.com/l/nxtslide-pro

# Master VIP / Admin Override Key (Optional):
# MASTER_LICENSE_KEY=VIP-FOUNDER-PASS-2026
